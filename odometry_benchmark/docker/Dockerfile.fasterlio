# Faster-LIO (Bai et al., RA-L 2022) - the reference repo's ROS 1 Noetic image
# (third_party/polegeo_odo_swaps/.../fasterlio_integration/docker/Dockerfile) with the upstream
# repo pinned to a commit and the build limited to 2 jobs. Same config as the reference results
# (config/ouster_os2_128.yaml: point_filter_num 4, filter_size_surf 1.0).
#   docker build -t fasterlio:noetic -f docker/Dockerfile.fasterlio \
#       third_party/polegeo_odo_swaps/Snow-pole-based-vehicle-localization/fasterlio_integration
FROM ros:noetic-ros-base
SHELL ["/bin/bash", "-lc"]
RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential cmake \
        libeigen3-dev libpcl-dev libgoogle-glog-dev libgflags-dev \
        libtbb-dev libyaml-cpp-dev \
        ros-noetic-pcl-ros ros-noetic-tf ros-noetic-eigen-conversions ros-noetic-rosbag \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /root/ws/src
RUN git clone https://github.com/gaoxiang12/faster-lio.git \
    && git -C faster-lio checkout 8038fbac95283708fe2aa30658b7e116a7ace6d8
COPY config/ouster_os2_128.yaml            /root/ws/src/faster-lio/config/ouster_os2_128.yaml
COPY config/mapping_ouster_os2_128.launch  /root/ws/src/faster-lio/launch/mapping_ouster_os2_128.launch
WORKDIR /root/ws
RUN source /opt/ros/noetic/setup.bash && catkin_make -DCMAKE_BUILD_TYPE=Release -j2
RUN echo "source /opt/ros/noetic/setup.bash" >> /root/.bashrc && echo "source /root/ws/devel/setup.bash" >> /root/.bashrc
WORKDIR /work
