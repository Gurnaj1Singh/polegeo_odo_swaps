<launch>
  <!-- FAST-LIO2 node only (no rviz); parameters as Faster-LIO's offline config -->
  <rosparam command="load" file="/cfg/ouster_os2_128.yaml" />
  <param name="feature_extract_enable" type="bool" value="0"/>
  <param name="point_filter_num" type="int" value="4"/>
  <param name="max_iteration" type="int" value="4" />
  <param name="filter_size_surf" type="double" value="1.0" />
  <param name="filter_size_map" type="double" value="0.5" />
  <param name="cube_side_length" type="double" value="1000" />
  <param name="runtime_pos_log_enable" type="bool" value="1" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" required="true" />
</launch>
