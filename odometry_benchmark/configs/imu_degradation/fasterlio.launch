<launch>
  <!-- Faster-LIO online node, no rviz; parameters = the offline config used for the paper baseline, IMU on /imu_deg -->
  <rosparam command="load" file="/cfg/fasterlio.yaml"/>
  <param name="feature_extract_enable" type="bool" value="false"/>
  <param name="runtime_pos_log_enable" type="bool" value="false"/>
  <node pkg="faster_lio" type="run_mapping_online" name="laserMapping" output="screen" required="true"/>
</launch>
